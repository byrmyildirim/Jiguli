# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g., https://jiguli.pro or http://localhost:3000)
APP_URL="http://localhost:3000"
PORT=3000

# ==========================================
# MySQL Database Configuration (Production / Live)
# ==========================================
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="jiguli_db"
DB_USER="root"
DB_PASSWORD=""
DB_PREFIX="jiguli_"
DB_SSL="false"
DB_CHARSET="utf8mb4"

